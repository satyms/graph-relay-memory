# -------------------------------------------------------------
# FalkorDB Connection
# -------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# -------------------------------------------------------------
# Model Configuration (OpenVINO local Qwen2.5 / Gemini fallback)
# -------------------------------------------------------------
MODEL_PROVIDER=openvino                  # 'openvino', 'gemini', or 'anthropic'
OPENVINO_BASE_URL=http://localhost:8000/v1
OPENVINO_MODEL=Qwen/Qwen2.5-7B-Instruct

# Cloud Fallback (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional Anthropic Provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# Security & Server
# -------------------------------------------------------------
ADMIN_TOKEN=relay-admin-secret-dev-token
SERVER_PORT=8080
